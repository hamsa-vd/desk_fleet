# Copy to .env and fill in. Never commit .env.

# ── LLM providers ────────────────────────────────────────────────
# Server-side key. Callers who bring their own (BYOK) bypass the shared secret.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — the brief's sanctioned alternative provider.
GROQ_API_KEY=

# ── API access ───────────────────────────────────────────────────
# Shared secret required only when a caller uses the SERVER's LLM key.
# Leave unset locally to keep dev frictionless; set it in Cloud Run.
API_KEY=

# ── LangSmith (tracing — this is a graded artifact) ───────────────
LANGCHAIN_TRACING_V2=true
# Must match your workspace region, or ingestion silently fails.
# US:  https://api.smith.langchain.com
# EU:  https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=deskfleet

# ── Upstream data APIs ───────────────────────────────────────────
# Orders always come from the mock — no public API exposes order status.
ORDER_API_BASE_URL=http://localhost:8081
# Products default to the mock; point at https://fakestoreapi.com for a live demo.
PRODUCT_API_BASE_URL=http://localhost:8081

# ── Database (Neon serverless Postgres, free tier) ────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/deskfleet?sslmode=require

# ── Metrics ──────────────────────────────────────────────────────
# Local: Prometheus scrapes /metrics via docker-compose, leave these unset.
# Deployed: set these to push to Grafana Cloud (free tier), since a
# scale-to-zero service cannot be scraped.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_KEY=

# ── Behaviour ────────────────────────────────────────────────────
MAX_ITERS=3
RECURSION_LIMIT=8
TOKEN_BUDGET_PER_TICKET=20000
LOG_LEVEL=INFO
